{
  "name": "@zeroeye/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node ../../scripts/clean-api.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "node ../../scripts/prisma.mjs generate",
    "db:migrate": "node ../../scripts/prisma.mjs migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@zeroeye/shared-types": "*",
    "@zeroeye/detection-rules": "*",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^8.1.0",
    "zod": "^3.25.76",
    "ws": "^8.18.3",
    "pino": "^9.14.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "vitest": "^5.0.3",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3",
    "@types/express": "^5.0.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/ws": "^8.18.1",
    "@types/node": "^24.7.0"
  }
